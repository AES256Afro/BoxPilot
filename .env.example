# The host-side port remains bound to loopback by docker-compose.yml.
BOXPILOT_PORT=8787

# Host-native QEMU/KVM discovery uses the system libvirt connection.
BOXPILOT_LIBVIRT_URI=qemu:///system
BOXPILOT_ISO_DIRECTORY=/var/lib/libvirt/boot
BOXPILOT_STATE_DIRECTORY=/var/lib/boxpilot

# Lifecycle changes remain locked unless both values are deliberately configured.
BOXPILOT_VM_ACTIONS_ENABLED=false
# BOXPILOT_ADMIN_TOKEN=replace-with-at-least-32-random-characters
