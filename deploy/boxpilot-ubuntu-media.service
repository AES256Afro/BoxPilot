[Unit]
Description=BoxPilot fixed official Ubuntu media acquisition
Documentation=https://github.com/AES256Afro/BoxPilot
Wants=network-online.target
After=network-online.target boxpilot-helper.service
ConditionPathExists=/usr/local/bin/node
ConditionPathIsDirectory=/var/lib/boxpilot-managed/vm-media-inbox
ConditionPathIsDirectory=/var/lib/boxpilot-managed/vm-media-acquisitions
ConditionPathExists=/run/boxpilot/ubuntu-media-approval.json

[Service]
Type=oneshot
User=boxpilot
Group=boxpilot
ExecStart=/usr/local/bin/node /opt/boxpilot/scripts/boxpilot-ubuntu-media.mjs
TimeoutStartSec=3h
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/run/boxpilot/ubuntu-media-approval.json
ReadWritePaths=/var/lib/boxpilot-managed/vm-media-inbox
ReadWritePaths=/var/lib/boxpilot-managed/vm-media-acquisitions
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
