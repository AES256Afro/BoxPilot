[Unit]
Description=BoxPilot web service
Wants=network-online.target
After=network-online.target
# Wants, not Requires. With Requires, one failed helper start at boot - the backup drive still
# being probed when its bind path was set up - cancelled this unit's start job as a "dependency
# failure", which systemd never retries; the helper then came up on its own restart five seconds
# later and the web service stayed down for hours. The web process already degrades to "helper
# unavailable" and recovers when the socket answers, so it should start regardless.
Wants=boxpilot-helper.service
After=boxpilot-helper.service
# The model gateway is part of this unit and of the helper (PartOf, so its view of their sockets is
# made again when either restarts), and PartOf carries a stop but not the start that follows it.
# 1.240.0 found that out on the owner's server: an upgrade run by the previous version's script
# stopped the helper, the gateway went with it, and nothing brought it back. Wanted from here, a
# start of BoxPilot is a start of the gateway whoever asked for it (an upgrade, a database put
# back, a person at a terminal). It starts only where a Claude key was stored: the gateway's own
# ConditionPathExists skips it everywhere else, and disconnecting Claude removes the key.
Wants=boxpilot-model-gateway.service

[Service]
Type=simple
User=boxpilot
Group=boxpilot
WorkingDirectory=/opt/boxpilot
EnvironmentFile=/etc/boxpilot/boxpilot.env
Environment=BOXPILOT_VM_MEDIA_INBOX=/var/lib/boxpilot-managed/vm-media-inbox
StateDirectory=boxpilot
StateDirectoryMode=0700
# serve.sock, which Tailscale Serve proxies to (server/serve-socket.mjs). Owned by this user, so
# tailscaled (root) can open it and no container can.
RuntimeDirectory=boxpilot-web
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/node /opt/boxpilot/server/index.mjs
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=-/var/lib/boxpilot-managed/vm-media-inbox
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
SystemCallArchitectures=native
# The web process serves HTTP and talks to the helper socket. It never needs a device, a namespace,
# a capability or a set-user-id bit, so none of those are reachable from it even if it is subverted.
PrivateDevices=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
