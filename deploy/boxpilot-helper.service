[Unit]
Description=BoxPilot restricted local helper
After=local-fs.target
Before=boxpilot.service

[Service]
Type=simple
User=root
Group=boxpilot
WorkingDirectory=/opt/boxpilot
Environment=NODE_ENV=production
Environment=BOXPILOT_HELPER_SOCKET=/run/boxpilot/helper.sock
Environment=BOXPILOT_APP_ROOT=/var/lib/boxpilot-managed/apps
Environment=BOXPILOT_DOCKER_BINARY=/usr/bin/docker
Environment=BOXPILOT_TAR_BINARY=/usr/bin/tar
Environment=BOXPILOT_JOURNALCTL_BINARY=/usr/bin/journalctl
Environment=BOXPILOT_VIRT_INSTALL_BINARY=/usr/bin/virt-install
Environment=BOXPILOT_VIRSH_BINARY=/usr/bin/virsh
Environment=BOXPILOT_QEMU_IMG_BINARY=/usr/bin/qemu-img
Environment=BOXPILOT_RESTIC_BINARY=/usr/bin/restic
Environment=BOXPILOT_FINDMNT_BINARY=/usr/bin/findmnt
Environment=BOXPILOT_TAILSCALE_BINARY=/usr/bin/tailscale
Environment=BOXPILOT_SYSTEMCTL_BINARY=/usr/bin/systemctl
Environment=BOXPILOT_VM_IMAGE_ROOT=/var/lib/libvirt/images
Environment=BOXPILOT_VM_EXPORT_ROOT=/var/lib/boxpilot-managed/vm-exports
Environment=BOXPILOT_VM_BACKUP_MOUNT=/mnt/boxpilot-backup
Environment=BOXPILOT_RESTIC_PASSWORD_FILE=/etc/boxpilot/secrets/vm-backup-restic-password
Environment=BOXPILOT_RESTIC_CACHE_DIRECTORY=/var/cache/boxpilot-restic
Environment=BOXPILOT_ISO_DIRECTORY=/var/lib/libvirt/boot
Environment=BOXPILOT_LIBVIRT_URI=qemu:///system
RuntimeDirectory=boxpilot
RuntimeDirectoryMode=0750
StateDirectory=boxpilot-managed
StateDirectoryMode=0700
CacheDirectory=boxpilot-restic
CacheDirectoryMode=0700
ExecStart=/usr/local/bin/node /opt/boxpilot/server/helper-server.mjs
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=-/mnt/boxpilot-backup
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
