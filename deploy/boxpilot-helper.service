[Unit]
Description=BoxPilot restricted local helper
After=local-fs.target
# The backup destination is usually a NAS share behind a systemd automount, at /mnt/boxpilot/backup.
# Ordering only: with its automount already in place the sandbox below copies it as it is; the NAS
# itself is never waited for, and may be off. See ReadWritePaths= for why nothing here names it.
After=mnt-boxpilot-backup.automount
Before=boxpilot.service

ConditionPathIsDirectory=/var/lib/boxpilot

[Service]
Type=simple
# Root is the system-service default. Explicit User=root with sandboxing can strip
# CAP_SETUID on current systemd, preventing the database probe from dropping to its owner.
# Keep this consistent with boxpilot-run@.service; Group still grants socket access.
Group=boxpilot
WorkingDirectory=/opt/boxpilot
Environment=NODE_ENV=production
Environment=BOXPILOT_HELPER_SOCKET=/run/boxpilot/helper.sock
Environment=BOXPILOT_APP_ROOT=/var/lib/boxpilot-managed/apps
Environment=BOXPILOT_MIGRATION_INBOX=/var/lib/boxpilot-migration/inbox
Environment=BOXPILOT_MIGRATION_STAGING_ROOT=/var/lib/boxpilot-managed/migration-staging
Environment=BOXPILOT_CONTROLLER_DATABASE=/var/lib/boxpilot/boxpilot.sqlite3
Environment=BOXPILOT_CONTROLLER_BACKUP_ROOT=/var/lib/boxpilot-managed/backups/boxpilot-controller
Environment=BOXPILOT_CONTROLLER_RESTORE_DRILL_ROOT=/var/lib/boxpilot-managed/controller-restore-drills
Environment=BOXPILOT_CONTROLLER_PROTECTION_DRILL_ROOT=/var/lib/boxpilot-managed/controller-independent-restore-drills
Environment=BOXPILOT_CONTROLLER_BACKUP_MOUNT=/mnt/boxpilot/backup
Environment=BOXPILOT_CONTROLLER_RESTIC_PASSWORD_FILE=/etc/boxpilot/secrets/controller-backup-restic-password
Environment=BOXPILOT_CONTROLLER_RESTIC_CACHE_DIRECTORY=/var/cache/boxpilot-controller-restic
Environment=BOXPILOT_APPLICATION_BACKUP_ROOT=/var/lib/boxpilot-managed/backups
Environment=BOXPILOT_APPLICATION_PROTECTION_DRILL_ROOT=/var/lib/boxpilot-managed/application-independent-restore-drills
Environment=BOXPILOT_APPLICATION_BACKUP_MOUNT=/mnt/boxpilot/backup
Environment=BOXPILOT_APPLICATION_RESTIC_PASSWORD_FILE=/etc/boxpilot/secrets/application-backup-restic-password
Environment=BOXPILOT_APPLICATION_RESTIC_CACHE_DIRECTORY=/var/cache/boxpilot-application-restic
Environment=BOXPILOT_DOCKER_BINARY=/usr/bin/docker
Environment=BOXPILOT_TAR_BINARY=/usr/bin/tar
Environment=BOXPILOT_JOURNALCTL_BINARY=/usr/bin/journalctl
Environment=BOXPILOT_VIRT_INSTALL_BINARY=/usr/bin/virt-install
Environment=BOXPILOT_VIRSH_BINARY=/usr/bin/virsh
Environment=BOXPILOT_QEMU_IMG_BINARY=/usr/bin/qemu-img
Environment=BOXPILOT_RESTIC_BINARY=/usr/bin/restic
Environment=BOXPILOT_FINDMNT_BINARY=/usr/bin/findmnt
Environment=BOXPILOT_TAILSCALE_BINARY=/usr/bin/tailscale
Environment=BOXPILOT_SYSTEMCTL_BINARY=/usr/bin/systemctl
Environment=BOXPILOT_VM_IMAGE_ROOT=/var/lib/libvirt/images
Environment=BOXPILOT_VM_MEDIA_INBOX=/var/lib/boxpilot-managed/vm-media-inbox
Environment=BOXPILOT_VM_EXPORT_ROOT=/var/lib/boxpilot-managed/vm-exports
Environment=BOXPILOT_VM_BACKUP_MOUNT=/mnt/boxpilot/backup
Environment=BOXPILOT_VM_RESTORE_DRILL_ROOT=/var/lib/libvirt/images/boxpilot-restore-drills
Environment=BOXPILOT_VM_RECOVERY_ROOT=/var/lib/libvirt/images/boxpilot-recoveries
Environment=BOXPILOT_LIBVIRT_QEMU_GROUP=libvirt-qemu
Environment=BOXPILOT_LIBVIRT_NVRAM_ROOT=/var/lib/libvirt/qemu/nvram
Environment=BOXPILOT_RESTIC_PASSWORD_FILE=/etc/boxpilot/secrets/vm-backup-restic-password
Environment=BOXPILOT_RESTIC_CACHE_DIRECTORY=/var/cache/boxpilot-restic
Environment=BOXPILOT_ISO_DIRECTORY=/var/lib/libvirt/boot
Environment=BOXPILOT_LIBVIRT_URI=qemu:///system
RuntimeDirectory=boxpilot
RuntimeDirectoryMode=0750
StateDirectory=boxpilot-managed boxpilot-migration
StateDirectoryMode=0700
CacheDirectory=boxpilot-restic boxpilot-controller-restic boxpilot-application-restic
CacheDirectoryMode=0700
# The web service stages ISO uploads in vm-media-inbox, so its group may pass through
# boxpilot-managed, never list or read it; everything else in there stays root's own. At 0700 every
# upload failed with EACCES. StateDirectoryMode= applies only when systemd creates the directory, so
# the mode is set on every start, which mends installs that already have it.
ExecStartPre=/usr/bin/chmod 0710 /var/lib/boxpilot-managed
ExecStartPre=/usr/bin/install -d -o boxpilot -g boxpilot -m 0700 /var/lib/boxpilot-managed/vm-media-inbox
ExecStart=/usr/local/bin/node /opt/boxpilot/server/helper-server.mjs
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
# read-only (not true): users.inspect counts ~/.ssh/authorized_keys entries to show SSH
# access state; writes to /home and /root stay blocked.
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
# The backup reads the database with VACUUM INTO. With the web service stopped SQLite has to
# recreate the WAL index, which a read-only mount refuses — exactly when a backup matters most.
ReadWritePaths=/var/lib/boxpilot
ReadWritePaths=-/var/lib/libvirt/images
ReadWritePaths=-/var/lib/libvirt/boot
ReadWritePaths=-/var/lib/libvirt/qemu/nvram
# The backup destination is mounted at /mnt/boxpilot/backup, and this is the folder above it, never
# the mount point itself. Setting up the sandbox resolves every path listed here, and resolving an
# automount point mounts the share: with the NAS off that fails with "No such device", which no
# "-" forgives, and the helper - every host operation BoxPilot has - stayed down, failing again
# five seconds after each try, for as long as the NAS was off. systemd 258+ resolves through
# automounts on purpose; 255 fires them from its nosuid pass (NoNewPrivileges=) and waits up to the
# mount timeout. Neither looks inside a folder it is given, so the share mounts on first use
# instead, writable, whether it was already mounted when the helper started or came up later.
# Nothing else under /mnt is opened. tests/ubuntu/helper-automount.sh proves all of it on real
# systemd with a real CIFS automount.
ReadWritePaths=-/mnt/boxpilot
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
