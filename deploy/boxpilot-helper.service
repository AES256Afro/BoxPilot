[Unit]
Description=BoxPilot restricted local helper
After=local-fs.target
Before=boxpilot.service

[Service]
Type=simple
User=root
Group=boxpilot
WorkingDirectory=/opt/boxpilot
Environment=NODE_ENV=production
Environment=BOXPILOT_HELPER_SOCKET=/run/boxpilot/helper.sock
Environment=BOXPILOT_APP_ROOT=/var/lib/boxpilot-managed/apps
Environment=BOXPILOT_DOCKER_BINARY=/usr/bin/docker
RuntimeDirectory=boxpilot
RuntimeDirectoryMode=0750
StateDirectory=boxpilot-managed
StateDirectoryMode=0750
ExecStart=/usr/local/bin/node /opt/boxpilot/server/helper-server.mjs
Restart=on-failure
RestartSec=5s
UMask=0007

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
