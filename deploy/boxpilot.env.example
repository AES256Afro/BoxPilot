NODE_ENV=production
BOXPILOT_HOST=127.0.0.1
BOXPILOT_PORT=8787
BOXPILOT_LIBVIRT_URI=qemu:///system
BOXPILOT_ISO_DIRECTORY=/var/lib/libvirt/boot
BOXPILOT_STATE_DIRECTORY=/var/lib/boxpilot
BOXPILOT_HELPER_SOCKET=/run/boxpilot/helper.sock
BOXPILOT_COOKIE_SECURE=true
BOXPILOT_STORAGE_HEALTH_PATH=/var/lib/boxpilot/storage-health.json
BOXPILOT_REDACTION_CONFIG=/etc/boxpilot/redaction.json
