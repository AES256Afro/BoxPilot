[Unit]
Description=BoxPilot root task %i (generic runner, see server/tasks)
Documentation=https://github.com/AES256Afro/BoxPilot
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/bin/node
ConditionPathExists=/run/boxpilot/run/%i.json

[Service]
Type=oneshot
# Runs as root (the default). Do not set User=root: combined with sandboxing it breaks
# apt's privilege drop to _apt. Do not add ProtectKernelModules/ProtectKernelLogs/
# PrivateDevices/ProtectSystem here: kernel, firmware, and bootloader packages write to
# /usr/lib/modules, /boot, and /dev, and dpkg maintainer scripts read dmesg — the same
# reason apt-daily-upgrade.service ships unsandboxed. Verified on Ubuntu 26.04.
# Per-task confinement belongs in server/tasks, not in this unit.
ExecStart=/usr/local/bin/node /opt/boxpilot/scripts/boxpilot-run.mjs %i
TimeoutStartSec=12h
UMask=0022
KillMode=process
PrivateTmp=true
RestrictRealtime=true
SystemCallArchitectures=native
