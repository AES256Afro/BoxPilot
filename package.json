{
  "name": "boxpilot",
  "version": "0.3.0",
  "private": true,
  "description": "A safety-first local control plane for Ubuntu home servers.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "doctor": "sh scripts/boxpilot-doctor.sh",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "check:shell": "sh -n scripts/boxpilot-doctor.sh",
    "check": "npm run build && npm run test && npm run check:shell"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
