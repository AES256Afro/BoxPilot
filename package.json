{
  "name": "boxpilot",
  "version": "1.17.14",
  "private": true,
  "description": "Point-and-click setup and management for an Ubuntu home server.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/boxpilot-web-dist-permissions.mjs",
    "doctor": "sh scripts/boxpilot-doctor.sh",
    "helper": "node server/helper-server.mjs",
    "agent": "node scripts/boxpilot-agent.mjs",
    "owner:token": "node scripts/boxpilot-owner.mjs create-bootstrap-token",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "check:shell": "for f in scripts/*.sh deploy/*.sh; do [ -e \"$f\" ] || continue; sh -n \"$f\" || exit 1; done",
    "lint": "eslint server scripts eslint.config.mjs",
    "check": "npm run build && npm run test && npm run check:syntax && npm run lint && npm run check:shell",
    "check:syntax": "find server scripts -name '*.mjs' -not -path '*/node_modules/*' -print0 | xargs -0 -n 1 node --check",
    "demo": "node scripts/boxpilot-demo.mjs",
    "demo:screenshots": "node scripts/demo-screenshots.mjs",
    "version": "node scripts/sync-version.mjs && git add docker-compose.yml README.md"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
