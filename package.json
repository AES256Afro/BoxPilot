{
  "name": "boxpilot",
  "version": "1.155.0",
  "private": true,
  "description": "Point-and-click setup and management for an Ubuntu home server.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/precompress-assets.mjs && node scripts/boxpilot-web-dist-permissions.mjs",
    "doctor": "sh scripts/boxpilot-doctor.sh",
    "helper": "node server/helper-server.mjs",
    "agent": "node scripts/boxpilot-agent.mjs",
    "owner:token": "node scripts/boxpilot-owner.mjs create-bootstrap-token",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "check:shell": "node scripts/check-sources.mjs shell",
    "check:retention": "node --expose-gc --max-old-space-size=128 scripts/check-runtime-retention.mjs",
    "lint": "eslint server scripts eslint.config.mjs",
    "check": "npm run build && npm run test && npm run check:syntax && npm run lint && npm run check:shell",
    "check:syntax": "node scripts/check-sources.mjs syntax",
    "demo": "node scripts/boxpilot-demo.mjs",
    "demo:screenshots": "node scripts/demo-screenshots.mjs",
    "demo:every-look": "node scripts/readme-every-look.mjs",
    "version": "node scripts/sync-version.mjs && git add docker-compose.yml README.md",
    "demo:sweep": "node scripts/demo-sweep.mjs",
    "demo:publish": "npm run build && node scripts/demo-assets.mjs && node scripts/demo-bundle.mjs && cp demo-site/demo-data.json demo-site/public/demo-data.json"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@fontsource/b612": "5.3.0",
    "@fontsource/b612-mono": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@fontsource/pt-sans": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
